# Timeweb PostgreSQL connection.
# Copy this file to .env.local and paste values from the Timeweb database panel.

DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# Optional. Use direct parts if you do not want to use DATABASE_URL.
DB_HOST=""
DB_PORT="5432"
DB_NAME=""
DB_USER=""
DB_PASSWORD=""
DB_SSL="true"
